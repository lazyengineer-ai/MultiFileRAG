# =============================================================================
# MultiFileRAG — Environment Variables
# Copy to apps/web/.env.local and apps/api/.env for local development.
# See docs/ARCHITECTURE.md and docs/TECHNICAL_PLAN.md §11
# =============================================================================

# --- Database (Neon in prod; local Docker Postgres) ---
DATABASE_URL=postgresql+psycopg://multifilerag:multifilerag@localhost:5432/multifilerag

# --- Auth.js (Next.js / Vercel) ---
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# --- OAuth providers ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- API auth (shared secret for JWT + server-to-server sync) ---
API_AUTH_SECRET=generate-a-long-random-string

# --- Next.js ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local: proxied via Next.js rewrite. Prod: Render service URL.
API_URL=http://localhost:8000

# --- Object storage (Cloudflare R2 in prod; MinIO locally) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=multifilerag
S3_REGION=us-east-1
# R2 only (leave empty for MinIO):
R2_ACCOUNT_ID=

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000

# --- OpenAI (Phase 2+) ---
OPENAI_API_KEY=
